<?xml version="1.0" encoding="UTF-8"?>
<!--
  Truthful Privacy Manifest (T-01-01 mitigation, RESEARCH §Security Domain).
  - NSPrivacyTracking: false           (the app does no tracking)
  - NSPrivacyTrackingDomains: empty    (no tracking domains)
  - NSPrivacyCollectedDataTypes: empty (nothing is collected by the developer — see CloudKit note)
  - NSPrivacyAccessedAPITypes: one entry — UserDefaults with required-reason CA92.1
    (the app reads/writes only its own consent + terminology flags).

  Phase 4 (resolved 2026-06-08): CloudKit private-database sync is now runtime-active
  (ModelContainer+Config `.private(...)`, gated on a signed-in iCloud account). Reconfirmed:
  - NSPrivacyCollectedDataTypes stays EMPTY and truthful. Health data is mirrored ONLY to the
    user's OWN private iCloud database (the user's iCloud identity, Apple-encrypted, not readable
    by the developer and never sent to any third-party controller). Under Apple's definition this
    is NOT "data collection" by the app/developer, so no collected-data-type entry is required.
  - NSPrivacyTracking stays false: private CloudKit is not "tracking" (no linkage across apps/sites,
    no third-party data, not used to track the user).
  - NSPrivacyAccessedAPITypes needs no new entry: the account presence check reads
    FileManager.ubiquityIdentityToken (a CloudKit/iCloud availability probe), which is NOT one of
    Apple's required-reason API categories; CloudKit itself does not require a manifest reason entry.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPITypeUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
