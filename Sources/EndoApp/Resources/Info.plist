<?xml version="1.0" encoding="UTF-8"?>
<!--
  iOS app Info.plist.
  CFBundleDisplayName "Endo-App" is the D-09 placeholder display name (finalize at branding/enrollment).
  No HealthKit / usage-description strings are present — none are needed yet (HealthKit is Phase 9).
  CloudKit sync is now ACTIVE (runtime-gated) in Phase 4: UIBackgroundModes (remote-notification, D-01/D-21
  — the CloudKit-sync decisions, NOT the D-04 withdraw-consent flow) ships below to let CloudKit drive
  silent push-sync. Inert without a DEVELOPMENT_TEAM + signed-in iCloud.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Endo-App</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- Phase 9 (DATA-05, D-06): READ-ONLY HealthKit usage string. Apple REQUIRES the share-usage key
	     below or the app crashes on first HealthKit access. Read-only posture: ONLY the share-usage key
	     is present — the corresponding WRITE/UPDATE usage key is intentionally OMITTED (write-back is
	     PLAT-01, deferred; its presence would imply write access, and the grep gate asserts it is absent).
	     The literal below is the source-of-truth copy mirrored from
	     HealthConnectCopy.healthShareUsageDescription and is ClaimsPolicy-audited by
	     HealthConnectCopyAuditTests (no forbidden verb, no gendered token). -->
	<key>NSHealthShareUsageDescription</key>
	<string>Endo-App can read your cycle, sleep, workout, and meal-day records from Apple Health so you do not have to log them twice. It stays on your device and in your private iCloud, and it is entirely optional.</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
