<!--
  Minimal :app manifest for Phase 18 (data layer only). Deliberately declares ZERO
  permissions — critically NO android.permission.INTERNET and NO health WRITE_* permission
  (this app never writes health data back and never talks to the network). No <activity>
  yet — the Compose shell arrives in Phase 19, which also lands the no-INTERNET manifest
  assertion against this clean baseline. Backup rules (dataExtractionRules /
  fullBackupContent) are owned by Plan 06 — deliberately absent here.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="Endo" />

</manifest>
