<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal :app manifest for Phase 18 (data layer only). Deliberately declares ZERO
  permissions — critically NO network/INTERNET permission and NO health WRITE_* permission
  (this app never writes health data back and never talks to the network). No <activity>
  yet — the Compose shell arrives in Phase 19, which also lands the no-network-permission
  manifest assertion against this clean baseline.

  Backup rules (Plan 06, APER-04): the Room health DB is EXCLUDED from Auto Backup and
  device transfer via @xml/data_extraction_rules (API 31+) and @xml/full_backup_content
  (API 26-30); only the DataStore consent/prefs may back up. BackupRulesTest pins the
  exclusion.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:label="Endo" />

</manifest>
